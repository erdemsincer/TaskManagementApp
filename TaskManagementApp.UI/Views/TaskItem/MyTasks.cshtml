@model List<TaskManagementApp.DtoLayer.Dtos.TaskItemDtos.ResultTaskItemDto>

@{
    ViewData["Title"] = "Görevlerim";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- FontAwesome -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

<style>
    .table-hover tbody tr:hover {
        background-color: #f8f9fa;
        transition: all 0.2s ease-in-out;
    }
</style>

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary">
            <i class="fas fa-tasks"></i> Görevlerim
        </h2>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="table-responsive shadow-sm rounded">
            <table class="table table-hover table-bordered align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th scope="col">#</th>
                        <th scope="col">Başlık</th>
                        <th scope="col">Durum</th>
                        <th scope="col">Öncelik</th>
                        <th scope="col">Atanan</th>
                        <th scope="col">İşlem</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var task in Model)
                    {
                        var statusClass = task.Status switch
                        {
                            "Done" => "badge bg-success",
                            "InProgress" => "badge bg-warning text-dark",
                            _ => "badge bg-secondary"
                        };

                        var priorityClass = task.Priority switch
                        {
                            "Yüksek" => "badge bg-danger",
                            "Orta" => "badge bg-warning text-dark",
                            "Düşük" => "badge bg-success",
                            _ => "badge bg-secondary"
                        };

                        <tr>
                            <td>@task.Id</td>
                            <td>@task.Title</td>
                            <td><span class="@statusClass">@GetStatusLabel(task.Status)</span></td>
                            <td><span class="@priorityClass">@task.Priority</span></td>
                            <td>@(string.IsNullOrWhiteSpace(task.AssignedToUser) ? "-" : task.AssignedToUser)</td>
                            <td>
                                <a asp-controller="TaskItem" asp-action="Detail" asp-route-id="@task.Id" class="btn btn-sm btn-outline-primary">
                                    <i class="fas fa-eye"></i> Detay
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info shadow-sm p-3 rounded text-center">
            <i class="fas fa-info-circle"></i> Henüz size atanmış bir görev bulunmamaktadır.
        </div>
    }
</div>

@functions {
    private string GetStatusLabel(string status)
    {
        return status switch
        {
            "ToDo" => "Yapılacak",
            "InProgress" => "Devam Ediyor",
            "Done" => "Tamamlandı",
            _ => status
        };
    }
}
