@using Microsoft.AspNetCore.Http

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Task Yönetim</title>

    <!-- Bootstrap & FontAwesome -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />
    <link rel="icon" href="/favicon.ico" type="image/x-icon" />

    <!-- Custom CSS -->
    <style>
        body {
            background-color: #f4f6f9;
        }

        .navbar-brand {
            font-weight: bold;
            font-size: 1.4rem;
            letter-spacing: 1px;
        }

        .nav-link {
            font-weight: 500;
        }

        footer {
            background-color: #212529;
            color: #ccc;
            padding: 20px 0;
            text-align: center;
            font-size: 0.9rem;
            margin-top: 80px;
        }

        .nav-link:hover {
            color: #0dcaf0 !important;
        }
    </style>

    @RenderSection("Styles", required: false)
</head>
<body>
    <!-- NAVBAR -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
        <div class="container-fluid px-4">
            <a class="navbar-brand" href="/">📝 TaskApp</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent"
                    aria-controls="navbarContent" aria-expanded="false" aria-label="Menüyü Aç/Kapat">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarContent">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item"><a class="nav-link" href="/Dashboard"><i class="fas fa-home me-1"></i> Dashboard</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Project"><i class="fas fa-diagram-project me-1"></i> Projeler</a></li>
                    <li class="nav-item"><a class="nav-link" href="/TaskItem/MyTasks"><i class="fas fa-tasks me-1"></i> Görevlerim</a></li>
                </ul>

                <ul class="navbar-nav mb-2 mb-lg-0">
                    @if (Context.Session.GetString("token") != null)
                    {
                        <li class="nav-item">
                            <span class="nav-link text-success fw-bold">
                                👋 @Context.Session.GetString("name")
                            </span>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-danger" href="/Account/Logout">
                                <i class="fas fa-sign-out-alt me-1"></i> Çıkış
                            </a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item"><a class="nav-link" href="/Account/Login"><i class="fas fa-sign-in-alt me-1"></i> Giriş</a></li>
                        <li class="nav-item"><a class="nav-link" href="/Account/Register"><i class="fas fa-user-plus me-1"></i> Kayıt Ol</a></li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <!-- MAIN -->
    <main class="container my-5">
        @RenderBody()
    </main>

    <!-- FOOTER -->
    <footer>
        <div class="container">
            <span>&copy; @DateTime.Now.Year - Task Yönetim Platformu | Developed by Erdem</span>
        </div>
    </footer>

    <!-- JS Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>

    @RenderSection("Scripts", required: false)

    <!-- SignalR Notification -->
    <script>
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/notificationHub")
            .build();

        connection.on("ReceiveNotification", message => {
            console.log("🔔 Yeni yorum bildirimi:", message);
            if (window.location.href.includes("/TaskItem/Detail")) {
                location.reload();
            }
        });

        connection.start().then(() => {
            console.log("🔗 SignalR bağlantısı kuruldu.");
        }).catch(err => console.error("❌ SignalR bağlantı hatası:", err));
    </script>
</body>
</html>
